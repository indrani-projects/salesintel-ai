# PRODUCTION environment for the VM. Install as /etc/salesintel/env (chmod 600,
# owned by the salesintel user). Fill the __from_local_.env__ values from your
# local backend/.env. NEVER commit the filled-in file — only this example lives in
# git. pydantic-settings reads these as env vars (case-insensitive).

# --- LLM (Gemini free tier) ---
LLM_API_KEY=__from_local_.env__
# LLM_BASE_URL / LLM_MODEL keep code defaults unless you overrode them locally.

# --- Google OAuth (Gmail send + Calendar). Replace __SITE_HOST__ with your host. ---
GOOGLE_CLIENT_ID=__from_local_.env__
GOOGLE_CLIENT_SECRET=__from_local_.env__
GOOGLE_REDIRECT_URI=https://__SITE_HOST__/api/auth/google/callback
FRONTEND_URL=https://__SITE_HOST__

# --- App ---
# Absolute path (four slashes) so the DB lives on the persistent disk, OUTSIDE the
# deploy dir — a redeploy can never clobber it. WAL sidecars sit alongside it.
DATABASE_URL=sqlite:////var/lib/salesintel/salesintel.db
CORS_ORIGINS=https://__SITE_HOST__

# --- Automated email recipient ---
DEFAULT_RECIPIENT=cosmossalestester@gmail.com
# Optional per-persona routing (JSON), copy from local .env if you use it:
# PERSONA_EMAILS='{"sales_rep":"rohan@acme.com","vp_sales":"vp@acme.com"}'
