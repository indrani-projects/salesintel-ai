# Keep shell scripts and git hooks LF-only so they run on macOS/Linux clones.
# (Windows CRLF on a #!/bin/sh script breaks it with "bad interpreter".)
.githooks/* text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Deploy artifacts consumed on the Linux VM — force LF. A CRLF systemd
# EnvironmentFile would append "\r" to secret values; CRLF in the unit/Caddyfile
# is likewise unsafe. rsync/scp from Windows then sends LF too.
deploy/Caddyfile text eol=lf
deploy/*.service text eol=lf
deploy/env.production.example text eol=lf

# GitHub Actions runs the `run:` blocks in bash on a Linux runner — CRLF would put
# a trailing "\r" on every scripted command. Keep workflow files LF-only.
.github/workflows/*.yml text eol=lf
