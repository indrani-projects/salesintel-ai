# ---- LLM provider (OpenAI-compatible) ----
# Default: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
# (step-by-step in README.md / docs/RUNBOOK.md). Paste the key after LLM_API_KEY= .
# Model note: "-latest" aliases keep working as Google rotates versions. If briefs
# ever fail with a 404 "model not found", pick a current one from AI Studio.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE

# ---- App ----
DATABASE_URL=sqlite:///./salesintel.db
DOCS_ROOT=../docs
# Comma-separated CORS origins for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Offline alternative (Ollama) — uncomment to use instead of Gemini ----
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=ollama

# ---- Email ("Send as email") ----
# Leave SMTP_* blank → "demo send": the email is composed + previewed in-app but
# NOT delivered (no setup needed, safe for demos). Fill all three of SMTP_HOST,
# SMTP_USER, SMTP_PASSWORD to send for real. For Gmail, enable 2-Step
# Verification and create an App Password (https://myaccount.google.com/apppasswords)
# — your normal password will NOT work over SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Prefills the To: field in the send dialog, AND is the recipient for automated
# emails below (the rep emails each brief to themselves). Blank ⇒ auto-email off.
DEFAULT_RECIPIENT=you@example.com

# ---- Automated brief emails ----
# When on, each meeting's brief is emailed automatically as soon as it's ready, and
# again REMINDER_LEAD_MINUTES before the meeting start time. Recipient is
# DEFAULT_RECIPIENT; delivery uses the same Gmail/SMTP/demo path as the manual "Send
# as email" button. Set AUTO_EMAIL_ENABLED=false to turn both off.
AUTO_EMAIL_ENABLED=true
REMINDER_LEAD_MINUTES=60
REMINDER_POLL_SECONDS=60
# Optional per-persona recipient routing (JSON). A meeting's auto-emails go to ITS
# persona's address here; personas without an entry fall back to DEFAULT_RECIPIENT.
# e.g. PERSONA_EMAILS={"sales_rep":"rohan@acme.com","vp_sales":"vp@acme.com"}
PERSONA_EMAILS=

# ---- Google (one OAuth: Gmail send + Calendar) ----
# Optional. Enables (a) sending brief emails from your Gmail and (b) two-way Google
# Calendar sync. Set up once at console.cloud.google.com (see docs/RUNBOOK.md):
#   1. Create a project; enable the Gmail API + Google Calendar API.
#   2. OAuth consent screen: External, Testing mode, add your Gmail as a Test user,
#      scopes gmail.send + calendar.events.
#   3. Create an OAuth client (Web application) with redirect URI matching
#      GOOGLE_REDIRECT_URI below; paste the client id/secret here.
# Leave blank to keep Google features off (email falls back to SMTP/demo).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Where the OAuth callback returns the browser (the app's Settings page).
FRONTEND_URL=http://localhost:5173
# Recurring Google Calendar auto-sync: a background thread re-imports prospect events
# every CALENDAR_SYNC_SECONDS so meetings added in Google appear without a manual
# "Sync" click. Fail-soft (an expired token just logs). Set CALENDAR_SYNC_ENABLED=false
# to rely on the manual Sync button + the one-time startup sync only.
CALENDAR_SYNC_ENABLED=true
CALENDAR_SYNC_SECONDS=30

# ---- Web prospect intel ----
# When a meeting is created, the brief pulls live web intel for the prospect
# (Google News RSS + SEC EDGAR + Reddit — all keyless), keyword-filters it, caches
# the filtered text for WEB_TTL_HOURS, and feeds it to the brief + Scout. Falls back
# to docs/<company>/ when the web returns nothing. Set WEB_INTEL_ENABLED=false to
# use local docs only.
WEB_INTEL_ENABLED=true
WEB_TTL_HOURS=24

# ---- Prepared web docs (deterministic foundation stage, NO LLM) ----
# `python -m app.tools.prepare "<company>"` (or --all) fetches real web pages +
# Wikipedia, extracts the main text (trafilatura), keeps only passages matching the
# research-guide keywords, scores each source's credibility, and caches clean Markdown
# + manifest.json under backend/.cache/prepared/<slug>/. load_company_intel prefers
# these over the live feeds when a manifest exists. No API key, no LLM, no cost.
PREP_ENABLED=true
PREP_MAX_RESULTS=10
PREP_TTL_HOURS=168
