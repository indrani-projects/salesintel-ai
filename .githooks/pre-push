#!/bin/sh
# ---------------------------------------------------------------------------
# pre-push — block DIRECT pushes to protected branches (main/master).
# The repo standard is: feature branch -> PR -> merge. main is never pushed to
# directly. Runs for every `git push` from this clone (see git-workflow skill).
#
# One-time enable per clone:   git config core.hooksPath .githooks
# Override for a single push:  SALESINTEL_ALLOW_MAIN=1 git push ...
# ---------------------------------------------------------------------------
protected='^(main|master)$'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  branch=${remote_ref#refs/heads/}
  if printf '%s' "$branch" | grep -Eq "$protected"; then
    if [ "${SALESINTEL_ALLOW_MAIN:-0}" = "1" ]; then
      echo "pre-push: OVERRIDE — allowing direct push to '$branch'." >&2
    else
      echo "" >&2
      echo "  ⛔ Blocked: direct push to protected branch '$branch'." >&2
      echo "     This repo forbids pushing to main/master directly." >&2
      echo "     Instead:" >&2
      echo "       1) git checkout -b <feat|fix|chore|docs>/<slug>" >&2
      echo "       2) commit your work on that branch" >&2
      echo "       3) git push -u origin <branch>" >&2
      echo "       4) open a PR into main" >&2
      echo "     One-time override: SALESINTEL_ALLOW_MAIN=1 git push ..." >&2
      echo "" >&2
      status=1
    fi
  fi
done

exit $status
