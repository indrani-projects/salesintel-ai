# Loaded only by `vite --mode share` (npm run dev:share) — used for tunnelled demos.
# Routes all API calls same-origin through the Vite dev proxy (see vite.config.ts),
# so one public tunnel URL serves both the app and the API. Normal `npm run dev`
# does NOT load this file and keeps talking to http://localhost:8000 directly.
VITE_API_URL=/api
